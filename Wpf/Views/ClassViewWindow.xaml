<Window x:Class="BBEdgeAgent.Wpf.Views.ClassViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Attendance"
        Icon="/Resources/bb.png"
        Width="900" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 행 높이를 40px로 늘려 버튼이 잘리지 않도록 -->
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ─── HEADER ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/bb.png" Width="26" Height="26"
                           Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Class Attendance" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding TodayHeader}"
                           FontSize="13" Foreground="{StaticResource TextSecond}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Loading indicator -->
                <TextBlock Grid.Column="2" Text="Loading..." FontSize="12"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                           Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ─── MAIN CONTENT ───────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Class List -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}"
                    BorderBrush="#243044" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Today's Classes"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}"
                               Margin="14,12,14,8"/>

                    <ListBox DockPanel.Dock="Top"
                             ItemsSource="{Binding Classes}"
                             SelectedItem="{Binding SelectedClass}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background"  Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"     Value="10,8,10,8"/>
                                <Setter Property="Margin"      Value="6,2,6,2"/>
                                <Setter Property="Cursor"      Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1E3050"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A2840"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding ClassName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{Binding StartTime}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,2,0,4"/>
                                    <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#243044"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AttendedCount}" Value="0">
                                                        <Setter Property="Background" Value="#243044"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AttendedCount}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Spacer -->
                    <Grid/>
                </DockPanel>
            </Border>

            <!-- RIGHT: Student List -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Class Header -->
                <Border Grid.Row="0" Background="#16203A" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGold}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Select a class"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedClass}" Value="{x:Null}">
                                            <Setter Property="Text" Value="Select a class"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedClass.ClassName}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentGold}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelectedClass, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text=" — " FontSize="14"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelectedClass, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SelectedClass.StartTime}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecond}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelectedClass, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Margin="16,0,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelectedClass, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding SelectedClass.Summary, Mode=OneWay}"/>
                            <Run Text=" attended"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Student ListView -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Students}"
                          Background="{StaticResource BgDark}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <!-- Name column -->
                            <GridViewColumn Header="Student" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Belt column -->
                            <GridViewColumn Header="Belt" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BeltName}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecond}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Attendance column -->
                            <GridViewColumn Header="Attendance" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- Attended badge -->
                                            <Border Background="#10B981" CornerRadius="10"
                                                    Padding="10,3"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding Attended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="White"
                                                           FontSize="12" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Check In button -->
                                            <Button Content="Check In"
                                                    Height="32" Width="100"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="12"
                                                    Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanCheckIn, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>

                    <!-- Empty state -->
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Students.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border Background="{StaticResource BgDark}">
                                                    <TextBlock Text="Select a class from the left panel"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                </ListView>
            </Grid>
        </Grid>

        <!-- ─── BOTTOM BAR ─────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMsg}"
                           VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Width="90" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Close" Width="90" Height="34"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
