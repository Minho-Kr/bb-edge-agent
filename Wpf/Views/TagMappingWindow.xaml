<Window x:Class="BBEdgeAgent.Wpf.Views.TagMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Mapping"
        Icon="/Resources/bb.png"
        Width="860" Height="620"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <DockPanel>
        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCard}" Padding="16,10">
            <DockPanel>
                <!-- Status -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMsg}"
                           VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Width="100" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Close" Width="100" Height="36"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content: two panels -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Student list (left) ────────────────────────── -->
            <DockPanel Grid.Column="0" Background="{StaticResource BgDark}">
                <!-- Search box -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="12,10">
                    <TextBlock Text="Students" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecond}"/>
                </Border>
                <Border DockPanel.Dock="Top" Padding="10,8" Background="{StaticResource BgDark}">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"/>
                </Border>
                <ListBox ItemsSource="{Binding Students}"
                         SelectedItem="{Binding SelectedStudent}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding BeltName}" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Separator -->
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}"/>

            <!-- ─── Tag list (right) ───────────────────────────── -->
            <DockPanel Grid.Column="2" Background="{StaticResource BgDark}">
                <!-- Header + action buttons -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="14,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="RFID Tags" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextSecond}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Scan mode indicator -->
                            <TextBlock Text="⬤ Scan active" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentGold}" Margin="0,0,12,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Content="Scan New Tag" Width="130" Height="34" Margin="0,0,8,0"
                                    Style="{StaticResource GoldButton}" FontSize="12"
                                    Command="{Binding EnterScanCommand}"/>
                            <Button Content="Remove Selected" Width="140" Height="34"
                                    Style="{StaticResource DangerButton}" FontSize="12"
                                    Command="{Binding RemoveTagCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Hint when no student selected -->
                <TextBlock DockPanel.Dock="Top" Text="← Select a student to view their tags"
                           FontSize="12" Foreground="{StaticResource TextMuted}"
                           Margin="16,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStudent}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedStudent.Id}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Tags list -->
                <ListView ItemsSource="{Binding Tags}"
                          x:Name="TagList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tag UID" Width="200" DisplayMemberBinding="{Binding TagUid}"/>
                            <GridViewColumn Header="Note"    Width="160" DisplayMemberBinding="{Binding Note}"/>
                            <GridViewColumn Header="Assigned" Width="110" DisplayMemberBinding="{Binding Assigned}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
