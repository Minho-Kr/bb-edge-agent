<Window x:Class="BBEdgeAgent.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BB Edge Agent"
        Icon="/Resources/bb.png"
        Width="480" Height="680"
        MinHeight="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ── 메인 콘텐츠 (세로 중앙) ── -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Logo -->
            <Image Source="/Resources/bb.png" Width="96" Height="96"
                   Stretch="Uniform" Margin="0,0,0,20"/>

            <!-- BB TAEKWONDO -->
            <TextBlock Text="BB TAEKWONDO"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource AccentGold}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,6"/>

            <!-- Edge Agent subtitle -->
            <TextBlock Text="Edge Agent"
                       FontSize="13" Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <!-- Login card -->
            <Border Background="{StaticResource BgCard}" CornerRadius="14"
                    Width="400">
                <StackPanel Margin="28,24,28,24">

                    <!-- Card title -->
                    <TextBlock Text="{Binding LoginTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,20"/>

                    <!-- PIN label -->
                    <TextBlock Text="PIN" FontSize="11"
                               Foreground="{StaticResource TextSecond}"
                               Margin="0,0,0,10"/>

                    <!-- 4 PIN boxes -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <PasswordBox x:Name="Pin1" MaxLength="1" Width="68" Height="80"
                                     Style="{StaticResource PinBox}" Margin="0,0,10,0"
                                     PasswordChanged="Pin1_Changed"/>
                        <PasswordBox x:Name="Pin2" MaxLength="1" Width="68" Height="80"
                                     Style="{StaticResource PinBox}" Margin="0,0,10,0"
                                     PasswordChanged="Pin2_Changed"/>
                        <PasswordBox x:Name="Pin3" MaxLength="1" Width="68" Height="80"
                                     Style="{StaticResource PinBox}" Margin="0,0,10,0"
                                     PasswordChanged="Pin3_Changed"/>
                        <PasswordBox x:Name="Pin4" MaxLength="1" Width="68" Height="80"
                                     Style="{StaticResource PinBox}"
                                     PasswordChanged="Pin4_Changed"/>
                    </StackPanel>

                    <!-- Error text -->
                    <TextBlock x:Name="ErrorText"
                               FontSize="12" Foreground="{StaticResource ErrorBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Login button -->
                    <Button x:Name="LoginBtn"
                            Content="{Binding LoginBtnText, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource GoldButton}"
                            Height="52" FontSize="14" FontWeight="Bold"
                            Click="LoginBtn_Click"/>

                    <!-- Hint -->
                    <TextBlock Text="{Binding DefaultPinHint, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── 하단 바 (언어 버튼) — 항상 보임 ── -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" Padding="16,0">
            <Button x:Name="LangBtn"
                    Style="{StaticResource GhostButton}"
                    Width="90" Height="34" FontSize="12"
                    HorizontalAlignment="Right"
                    Click="LangBtn_Click"/>
        </Border>
    </Grid>
</Window>
