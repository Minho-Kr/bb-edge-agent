<Window x:Class="BBEdgeAgent.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BB Edge Agent"
        Icon="/Resources/bb.png"
        MinWidth="1024" MinHeight="680"
        WindowState="Maximized"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ CONTENT (left) ═══════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <!-- ─── TOP BAR ────────────────────────────────────── -->
            <Border Grid.Row="0" Background="{StaticResource BgCard}">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Branch -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/bb.png" Width="28" Height="28"
                               Stretch="Uniform" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding BranchName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Status chips (right-aligned) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- Reader status -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReaderOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Reader" FontSize="12" Foreground="{StaticResource TextSecond}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Cloud status -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CloudOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Cloud" FontSize="12" Foreground="{StaticResource TextSecond}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecond}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Run Text="Today: "/><Run Text="{Binding TodayCount, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock x:Name="QueueChip" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QueueCount}" Value="0">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Queued: "/><Run Text="{Binding QueueCount, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding TimeDisplay}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── SCAN AREA ───────────────────────────────────── -->
            <Border x:Name="ScanBorder" Grid.Row="1">
                <Border.Background>
                    <SolidColorBrush x:Name="ScanBg" Color="{StaticResource BgCardColor}"/>
                </Border.Background>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="680">
                    <!-- State icon -->
                    <TextBlock x:Name="ScanIconText" Text="{Binding ScanIcon}"
                               FontSize="72" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanState}" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanState}" Value="Already">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanState}" Value="NotFound">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Student name / scan prompt -->
                    <TextBlock x:Name="ScanTitleText" Text="{Binding ScanTitle}"
                               TextAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontSize"   Value="26"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanState}" Value="Success">
                                        <Setter Property="FontSize"   Value="44"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanState}" Value="Already">
                                        <Setter Property="FontSize"   Value="36"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanState}" Value="NotFound">
                                        <Setter Property="FontSize"   Value="26"/>
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Belt name -->
                    <TextBlock Text="{Binding ScanBelt}"
                               FontSize="22" TextAlignment="Center"
                               Foreground="{StaticResource AccentGold}"
                               HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanBelt}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Sub text (time / hint) -->
                    <TextBlock Text="{Binding ScanSub}"
                               FontSize="14" TextAlignment="Center"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanSub}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ─── RECENT LOG ──────────────────────────────────── -->
            <Grid Grid.Row="2" Background="{StaticResource BgDark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log header -->
                <Border Grid.Row="0" Background="#141E2E" Padding="12,8">
                    <TextBlock Text="Recent Attendance" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecond}" FontSize="13"/>
                </Border>

                <!-- Log list -->
                <ListView Grid.Row="1" ItemsSource="{Binding RecentLog}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time"   Width="100" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Name"   Width="220" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Belt"   Width="160" DisplayMemberBinding="{Binding Belt}"/>
                            <GridViewColumn Header="Source" Width="90"  DisplayMemberBinding="{Binding Source}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- ═══ SIDEBAR (right) ══════════════════════════════════ -->
        <Border Grid.Column="1" Background="{StaticResource BgSidebar}">
            <DockPanel>
                <!-- Sidebar header -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="16,16,16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="/Resources/bb.png" Width="30" Height="30"
                                   Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="BB Edge Agent" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BranchName}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Margin="40,0,0,0"/>
                    </StackPanel>
                </Border>

                <Separator DockPanel.Dock="Top"/>

                <!-- Scan status indicator -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,10,0,4">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text"       Value="Stopped"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Text"       Value="Scanning"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Start/Stop Scan button -->
                <Button DockPanel.Dock="Top" Command="{Binding ToggleScanCommand}"
                        Height="62" Margin="14,6,14,10" FontSize="14" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GoldButton}">
                            <Setter Property="Content" Value="Start Scan"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Content"     Value="Stop Scan"/>
                                    <Setter Property="Background"  Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Separator DockPanel.Dock="Top"/>

                <!-- Nav buttons -->
                <Button DockPanel.Dock="Top" Content="Class View" Height="52"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ClassViewCommand}"/>
                <Button DockPanel.Dock="Top" Content="Tag Mapping" Height="52"
                        Style="{StaticResource NavButton}"
                        Command="{Binding TagMappingCommand}"/>
                <Button DockPanel.Dock="Top" Content="Manual Check-in" Height="52"
                        Style="{StaticResource NavButton}"
                        Command="{Binding ManualCheckInCommand}"/>
                <Button DockPanel.Dock="Top" Content="Sync Now" Height="52"
                        Style="{StaticResource NavButton}"
                        Command="{Binding SyncNowCommand}"/>
                <Button DockPanel.Dock="Top" Content="Settings" Height="52"
                        Style="{StaticResource NavButton}"
                        Command="{Binding SettingsCommand}"/>
                <Button DockPanel.Dock="Top" Content="RFID Log" Height="52"
                        Style="{StaticResource NavButton}"
                        Command="{Binding RfidLogCommand}"/>

                <!-- Bottom: Lang + Logout -->
                <Separator DockPanel.Dock="Bottom"/>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCard}" Padding="12,12">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LangBtn" Width="92" Height="34"
                                Style="{StaticResource GhostButton}" FontSize="12"
                                Click="LangBtn_Click"/>
                        <Button Content="Logout" Width="92" Height="34" Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}" FontSize="12"
                                Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Spacer -->
                <Grid/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
