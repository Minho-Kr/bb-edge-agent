<Window x:Class="BBEdgeAgent.Wpf.Views.RfidLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFID Scan Log"
        Width="820" Height="620"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/bb.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="ListViewItem">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2A40"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F3050"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/bb.png" Width="26" Height="26"
                           Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="RFID Scan Log" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Range selector -->
                <ComboBox Grid.Column="1" Width="160" Height="30"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          SelectedIndex="{Binding RangeIndex}"
                          Background="{StaticResource BgDark}"
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="#334466">
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Last 7 Days"/>
                    <ComboBoxItem Content="Last 30 Days"/>
                </ComboBox>

                <!-- Right: Loading indicator -->
                <TextBlock Grid.Column="2" Text="Loading..." FontSize="12"
                           Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"
                           Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ═══ CONTENT ══════════════════════════════════════════ -->
        <ListView Grid.Row="1" ItemsSource="{Binding Logs}"
                  Background="{StaticResource BgDark}"
                  BorderThickness="0"
                  Foreground="{StaticResource TextPrimary}">
            <ListView.View>
                <GridView>
                    <!-- GridView column header style (dark theme) -->
                    <GridView.ColumnHeaderContainerStyle>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background"   Value="{StaticResource BgCard}"/>
                            <Setter Property="Foreground"   Value="{StaticResource TextSecond}"/>
                            <Setter Property="FontSize"     Value="11"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="Padding"      Value="8,6"/>
                            <Setter Property="BorderBrush"  Value="#243050"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </GridView.ColumnHeaderContainerStyle>

                    <!-- Time -->
                    <GridViewColumn Header="Time" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FirstScanDisplay}"
                                           FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Tag UID -->
                    <GridViewColumn Header="Tag UID" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TagUid}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextSecond}"
                                           VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Student -->
                    <GridViewColumn Header="Student" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="{Binding StudentName}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StudentName}" Value="">
                                                    <Setter Property="Text"       Value="Unknown"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Count -->
                    <GridViewColumn Header="Count" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScanCount}" Value="1">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ScanCount}" FontSize="13"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentGold}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScanCount}" Value="1">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Result -->
                    <GridViewColumn Header="Result" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ResultDisplay}" FontSize="13"
                                           VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="success">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="already_checked_in">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="tag_not_found">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMsg}"
                           FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Button Content="Refresh" Width="90" Height="34" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Close" Width="90" Height="34"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
