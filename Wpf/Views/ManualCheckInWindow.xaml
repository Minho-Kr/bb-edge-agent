<Window x:Class="BBEdgeAgent.Wpf.Views.ManualCheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Check-in"
        Icon="/Resources/bb.png"
        Width="520" Height="580"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <DockPanel>
        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCard}" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMsg}"
                           VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="100" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="Confirm Check-in" Width="150" Height="36"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <StackPanel Margin="20,16,20,0">
            <TextBlock Text="Manual Check-in" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text="Select student and confirm attendance."
                       FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16"/>

            <!-- Search -->
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" Margin="0,0,0,12"/>

            <!-- Student list -->
            <ListBox ItemsSource="{Binding Students}"
                     SelectedItem="{Binding SelectedStudent}"
                     Height="360">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3,0,3">
                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding BeltName}" FontSize="11"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
