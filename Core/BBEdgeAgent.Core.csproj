<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BBEdgeAgent.Core</AssemblyName>
    <RootNamespace>BBEdgeAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9</LangVersion>
  </PropertyGroup>

  <!-- Link existing source files (no duplication) -->
  <ItemGroup>
    <Compile Include="..\AppConfig.cs"              Link="AppConfig.cs"/>
    <Compile Include="..\Lang.cs"                   Link="Lang.cs"/>
    <Compile Include="..\Models\Student.cs"         Link="Models\Student.cs"/>
    <Compile Include="..\Services\AttendanceService.cs" Link="Services\AttendanceService.cs"/>
    <Compile Include="..\Services\LocalDbService.cs"    Link="Services\LocalDbService.cs"/>
    <Compile Include="..\Services\SupabaseService.cs"   Link="Services\SupabaseService.cs"/>
    <!-- Core\Services\RfidService.cs is auto-included by SDK (uses System.Timers.Timer) -->
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http"/>
    <Reference Include="System.Security"/>
    <Reference Include="ADRcpLib">
      <HintPath>..\..\bb-ai-hub\rfid\ReaderSDK\ReaderSDK_Demo\bin\x64\Debug\ADRcpLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ADSioLib">
      <HintPath>..\..\bb-ai-hub\rfid\ReaderSDK\ReaderSDK_Demo\bin\x64\Debug\ADSioLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ADUtilsLib">
      <HintPath>..\..\bb-ai-hub\rfid\ReaderSDK\ReaderSDK_Demo\bin\x64\Debug\ADUtilsLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json"     Version="13.0.3"/>
    <PackageReference Include="System.Data.SQLite"  Version="1.0.118"/>
  </ItemGroup>
</Project>
